Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/LaserScan
      Name: SimulatedLidar
      Enabled: true
      Topic:
        Value: /ldlidar_node/scan
      Size (m): 0.05
      Color: 255; 0; 0
    - Class: rviz_default_plugins/MarkerArray
      Name: GroundTruthMap
      Enabled: true
      Topic:
        Value: /simulator/ground_truth_map
    - Class: rviz_default_plugins/MarkerArray
      Name: DetectedConsMap
      Enabled: true
      Topic:
        Value: /cons_map_markers
    - Class: rviz_default_plugins/Marker
      Name: PlannedPath
      Enabled: true
      Topic:
        Value: /simulator/path_markers
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /simulator/path
  Global Options:
    Fixed Frame: map
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 900
  Width: 1400
