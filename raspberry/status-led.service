# LEDs de la Sense HAT amb l'estat del cotxe (launcher/status_led.py).
# S'instal·la amb: sudo ./raspberry/install_status_led.sh
# (l'script substitueix @USER@ i @REPO_DIR@)
[Unit]
Description=LEDs de la Sense HAT amb l'estat del cotxe
Wants=network-online.target
After=network-online.target

[Service]
User=@USER@
# Si fas servir ROS_DOMAIN_ID (o altres variables de ROS) al teu .bashrc,
# posa-les també aquí perquè el servei vegi els teus launch:
# Environment=ROS_DOMAIN_ID=0
# Sense pantalla HDMI, la matriu de la Sense HAT és /dev/fb0 i la consola de
# text del kernel s'hi dibuixa a sobre (el cursor fa parpellejar els LEDs).
# En aquest cas es desconnecta la consola del framebuffer. El + fa que
# s'executi com a root encara que el servei sigui de @USER@.
ExecStartPre=+/bin/sh -c 'grep -qx "RPi-Sense FB" /sys/class/graphics/fb0/name || exit 0; for d in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" $d/name && echo 0 > $d/bind; done; true'
# network-online.target no sempre espera el WiFi. Si el node de ROS arrenca
# abans que la xarxa estigui activa, després no veu els nodes dels launch
# (els LEDs es queden en verd). S'espera fins a 60 s que hi hagi xarxa, i 10 s
# més: si arrenca el mateix segon que el DHCP dona la IP, tampoc els veu.
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do ip -4 route | grep -q default && break; sleep 1; done; sleep 10'
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source @REPO_DIR@/install/setup.bash && exec ros2 run my_pakage status_led'
# SIGINT perquè el node apagui els LEDs abans de sortir.
KillSignal=SIGINT
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
